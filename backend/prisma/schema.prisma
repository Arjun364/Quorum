// M0 schema: organization layer, users, auth tokens, email and audit logs.
// Later milestones add departments' settings, tags, meetings, points, etc.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  PlatformOwner
  Admin
  CompanyHead
  DepartmentHead
  Employee
}

enum UserStatus {
  Pending
  Active
  Inactive
}

enum MeetingLanguage {
  Malayalam
  English
  Mixed
}

model Organization {
  id              Int             @id @default(autoincrement())
  name            String
  slug            String          @unique
  meetingLanguage MeetingLanguage @default(English)
  timeZone        String          @default("Asia/Kolkata")
  // ISO weekdays 1 (Mon) .. 7 (Sun)
  workingDays     Int[]           @default([1, 2, 3, 4, 5])
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())

  departments Department[]
  users       User[]
}

model Department {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  code           String
  headUserId     Int?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  createdBy      Int?

  users User[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model User {
  id                 Int           @id @default(autoincrement())
  // null only for the PlatformOwner
  organizationId     Int?
  organization       Organization? @relation(fields: [organizationId], references: [id])
  departmentId       Int?
  department         Department?   @relation(fields: [departmentId], references: [id])
  name               String
  // stored lowercase; unique across the platform (one email, one organization)
  email              String        @unique
  passwordHash       String
  systemRole         SystemRole
  status             UserStatus    @default(Active)
  mustChangePassword Boolean       @default(false)
  failedLoginCount   Int           @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  refreshTokens RefreshToken[]

  @@index([organizationId])
  @@index([departmentId])
}

model RefreshToken {
  id             Int       @id @default(autoincrement())
  organizationId Int?
  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([userId])
}

model EmailLog {
  id             Int      @id @default(autoincrement())
  organizationId Int?
  userId         Int?
  toEmail        String
  type           String
  subject        String
  status         String
  error          String?
  sentAt         DateTime @default(now())

  @@index([organizationId])
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  organizationId Int?
  userId         Int?
  action         String
  entityType     String
  entityId       String?
  details        Json?
  timestamp      DateTime @default(now())

  @@index([organizationId])
}
