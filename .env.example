# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose + backend) ---
POSTGRES_USER=deptapp
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=deptapp
DATABASE_URL=postgresql://deptapp:change-me-local-only@localhost:5432/deptapp?schema=public

# --- API ---
# Companies live on subdomains of this host (use <slug>.localhost:5173 in development).
# Behind a proxy, also set TRUST_PROXY=true.
PORT=3000
APP_BASE_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
COOKIE_SECURE=false

# --- Bootstrap: used ONLY when there are no users yet ---
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-strong-temporary-password

# --- Email (Mailpit in development) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=Quorum <no-reply@localhost>

# --- Cloudinary crenditials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Cloudinary (image uploads: company logos, later profile photos). Never commit real values. ---
